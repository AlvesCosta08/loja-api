    {
      "name": "Products",
      "item": [
        {
          "name": "List Products (paged + filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=10&category=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "category", "value": "" },
                { "key": "search", "value": "" }
              ]
            },
            "description": "Lista paginada. Sort padrão: `name` asc. Cache Redis (TTL 5 min)."
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Create Product (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('productId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camiseta Preta\",\n  \"description\": \"Camiseta 100% algodão\",\n  \"price\": 59.90,\n  \"stock\": 100,\n  \"category\": \"Roupas\",\n  \"imageUrl\": \"https://placehold.co/400\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Requer role ADMIN. Salva `productId`."
          }
        },
        {
          "name": "Update Product (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camiseta Preta (v2)\",\n  \"description\": \"Modelagem atualizada\",\n  \"price\": 69.90,\n  \"stock\": 80,\n  \"category\": \"Roupas\",\n  \"imageUrl\": \"https://placehold.co/400\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Requer role ADMIN. Dispara `@CacheEvict`."
          }
        },
        {
          "name": "Delete Product (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Requer role ADMIN. Publica `ProductEvent(active=false)` no indexer do RAG."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
