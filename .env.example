# =====================================================================
# Loja API — variáveis de ambiente
#
# Uso: copie para .env (que é gitignored) e ajuste os valores.
#   cp .env.example .env
# =====================================================================

# ----- Banco de dados -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja
DB_USER=postgres
DB_PASS=postgres

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- JWT -----
JWT_SECRET=change-me-in-production-with-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# ----- Spring -----
SPRING_PROFILES_ACTIVE=dev

# ----- Servidor -----
SERVER_PORT=8080