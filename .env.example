# =====================================================================
# Loja API — variáveis de ambiente
#
# Uso: copie para .env (que é gitignored) e ajuste os valores.
#   cp .env.example .env
# =====================================================================

# ----- Banco de dados (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja
DB_USER=postgres
DB_PASS=postgres
# Local: disable | Render: require
DB_SSLMODE=disable

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
# Local: vazio | Render: senha do Key Value
REDIS_PASSWORD=
# Local: false | Render: true
REDIS_SSL=false

# ----- JWT -----
# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=change-me-in-production-with-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# ----- Spring -----
# Local: vazio (usa application.yml default)
# Render: prod (ativa guardas do SecurityConfig)
SPRING_PROFILES_ACTIVE=

# ----- Servidor -----
SERVER_PORT=8080

# ----- CORS -----
# Local: http://localhost:5173
# Render: https://loja-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173