# =====================================================================
# Loja API — variáveis de ambiente
#
# Uso: copie para .env (que é gitignored) e ajuste os valores.
#   cp .env.example .env
#
# Para deploy no Render, veja a seção "Render" no final.
# =====================================================================

# ----- Banco de dados (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja
DB_USER=postgres
DB_PASS=postgres
# Local: disable | Render: require
DB_SSLMODE=disable

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
# Local: vazio | Render: senha do Key Value
REDIS_PASSWORD=
# Local: false | Render: true
REDIS_SSL=false

# ----- JWT -----
# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=change-me-in-production-with-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# ----- Spring -----
# Deixe vazio em dev (usa application.yml default).
# Em produção: prod ou production (ativa guardas do SecurityConfig).
SPRING_PROFILES_ACTIVE=

# ----- Servidor -----
SERVER_PORT=8080

# ----- CORS -----
# Local: http://localhost:5173
# Múltiplas origens: http://localhost:5173,https://loja-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173


# =====================================================================
# RENDER — valores recomendados no dashboard do Web Service
# =====================================================================
#
# DB_HOST=<host-do-postgres>
# DB_PORT=5432
# DB_NAME=loja
# DB_USER=loja
# DB_PASS=<senha-do-postgres>
# DB_SSLMODE=require
#
# REDIS_HOST=<host-do-redis>
# REDIS_PORT=6379
# REDIS_PASSWORD=<senha-do-redis>
# REDIS_SSL=true
#
# JWT_SECRET=<openssl rand -base64 48>
# JWT_EXPIRATION_MS=3600000
#
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=https://loja-web.onrender.com
#
# Observação: o Render injeta automaticamente:
#   - RENDER=true        (ativa guardas de produção no SecurityConfig)
#   - PORT=<porta>       (o application.yml faz fallback)
# =====================================================================